---
import Main from "../layouts/Main.astro";
const pageTitle = "Uses | Joanna Hosking - Web Developer";
---

<Main pageTitle={pageTitle}>
  <div class="uses">
    <h1>Uses</h1>
    <p>
      Tools and tech I use regularly, inspired by Wes Bos' <a
        href="https://uses.tech/"
        target="_blank"
        rel="noreferrer">uses.tech</a
      >.
    </p>

    <h2>Hardware</h2>
    <ul>
      <li>
        Custom PC
        <ul>
          <li>Windows 11</li>
          <li>Intel Core i7-12700KF (12th Gen, 3.60GHz)</li>
          <li>NVIDIA GeForce RTX 4060 Ti 8GB</li>
          <li>32GB RAM</li>
        </ul>
      </li>
      <li>Custom built keyboard and Glorious Model O mouse</li>
      <li>iPhone 14</li>
      <li>Sony WH-CH520</li>
    </ul>

    <h2>Software</h2>
    <ul>
      <li>
        <a
          href="https://code.visualstudio.com/"
          target="_blank"
          rel="noreferrer">VS Code</a
        >
        <ul>
          <li>
            <a
              href="https://github.com/barklan/kanagawa.vscode"
              target="_blank"
              rel="noreferrer">Kanagawa</a
            > theme
          </li>
          <li>
            <a
              href="https://www.jetbrains.com/lp/mono/"
              target="_blank"
              rel="noreferrer">JetBrains Mono</a
            > font
          </li>
          <li>Prettier</li>
        </ul>
      </li>
      <li>
        <a
          href="https://claude.com/product/claude-code"
          target="_blank"
          rel="noreferrer">Claude Code</a
        >
      </li>
      <li>
        <a href="https://astro.build/" target="_blank" rel="noreferrer">Astro</a
        >
      </li>
      <li>npm</li>
      <li>Git</li>
      <li>Chrome, Chrome Canary, and Firefox</li>
      <li>
        <a href="https://figma.com/" target="_blank" rel="noreferrer">Figma</a>
      </li>
    </ul>

    <h2>Services</h2>
    <ul>
      <li>
        <a
          href="https://github.com/joannahosking"
          target="_blank"
          rel="noreferrer">GitHub</a
        >
      </li>
      <li>
        <a href="https://supabase.com/" target="_blank" rel="noreferrer"
          >Supabase</a
        >
      </li>
      <li>
        <a href="https://www.netlify.com/" target="_blank" rel="noreferrer"
          >Netlify</a
        >
      </li>
      <li>
        <a
          href="https://buymeacoffee.com/joannahosking"
          target="_blank"
          rel="noreferrer">Buy Me a Coffee</a
        >
      </li>
    </ul>

    <h2>Miscellaneous</h2>
    <ul>
      <li>
        <a href="https://www.goatcounter.com/" target="_blank" rel="noreferrer"
          >GoatCounter</a
        >
      </li>
      <li>
        <a href="https://regex101.com/" target="_blank" rel="noreferrer"
          >Regex101</a
        >
      </li>
      <li>
        <a href="https://www.typewolf.com/" target="_blank" rel="noreferrer"
          >Typewolf</a
        >
      </li>
      <li>
        <a href="https://boxicons.com/" target="_blank" rel="noreferrer"
          >Boxicons</a
        >
      </li>
      <li>
        <a href="https://itch.io/" target="_blank" rel="noreferrer">itch.io</a>
      </li>
    </ul>
  </div>
</Main>

<style>
  .uses {
    h2 {
      margin-bottom: 0.25rem;
    }

    ul {
      padding-left: 1.5rem;
      margin-top: 0;
      line-height: 1.75;

      ul {
        margin: 0;
      }
    }
  }
</style>
